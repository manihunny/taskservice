# HTTP
HTTP_ADDR=:8080
APP_PORT=8080
LOG_LEVEL=info

# MySQL. MYSQL_PORT - также порт MySQL на хосте (127.0.0.1) в docker compose;
# внутри compose приложение ходит на mysql:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=taskservice
MYSQL_USER=taskservice
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Либо целиком: MYSQL_DSN=user:pass@tcp(host:3306)/db?parseTime=true&loc=UTC

# Redis. REDIS_PORT - порт Redis на хосте (127.0.0.1) в docker compose
REDIS_PORT=6379
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# Rate limit на IP
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
